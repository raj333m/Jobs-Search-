PORT=3000
APP_URL=http://localhost:3000
# Register APP_URL/auth/linkedin/callback in your LinkedIn developer app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional trusted HTTPS endpoint returning an array of jobs with title,
# company, location, description, applyLink, posted, and optional recruiter/referral fields.
JOB_FEED_URL=
JOB_FEED_TOKEN=
# Identifies the authorised provider supplying JOB_FEED_URL: linkedin or naukri.
# A generic feed or basic LinkedIn identity sign-in does not satisfy the source requirement.
JOB_FEED_SOURCE=

# Optional candidate provider adapter (not activated until live coverage and display rights are verified).
THEIRSTACK_API_KEY=

# Career assistant MVP delivery configuration
# Windows generates an AES-256 key protected with current-user DPAPI automatically.
# Non-Windows: set CAREER_DATA_KEY to a base64-encoded 32-byte secret outside source control.
# CAREER_STORE_PATH=data/career-vault.json
# Daily digest delivery; set these locally, never paste passwords into chat.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# For HTTPS, supply a trusted certificate and private key, and set APP_URL=https://...
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# --- Hosting on Vercel ---
# Set automatically when Upstash Redis is connected to the Vercel project:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Set in Vercel project settings (never commit real values):
# CAREER_DATA_KEY=   (base64 32-byte key; required on Vercel)
# CRON_SECRET=       (protects the daily /api/cron job)
# APP_URL=https://your-next-move-awaits.vercel.app
